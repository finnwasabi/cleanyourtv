<?xml version="1.0" encoding="utf-8"?>
<!-- One channel row (ChannelsAdapter): the channel's name over its programs, which sit in the app grid's columns. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The title, and at the far end of the line the scroll indicator, lined up with the last column's card. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/channelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bevietnam_medium"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp"
            android:letterSpacing="0.02"
            android:singleLine="true" />

        <com.gathin.tvhome.RowIndicator
            android:id="@+id/rowIndicator"
            android:layout_width="44dp"
            android:layout_height="3dp"
            android:layout_gravity="end|center_vertical"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/programs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:overScrollMode="never" />
</LinearLayout>
