<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button: a glass card at the right edge, centred top to
     bottom, the same over Home and over any app. Same glass and rows as the Inputs dropdown. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="28dp"
        android:orientation="vertical"
        android:background="@drawable/quick_panel"
        android:padding="6dp"
        android:elevation="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:text="@string/quick_settings_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/bevietnam_medium"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
