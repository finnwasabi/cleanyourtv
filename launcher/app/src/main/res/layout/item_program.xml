<?xml version="1.0" encoding="utf-8"?>
<!-- A program in a channel row, laid out like item_app.xml: one grid cell wide, the card at tile size, the name
     under it while focused. ChannelsAdapter sets the cell and card sizes from the app grid's. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <TextView
            android:id="@+id/posterLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:fontFamily="@font/outfit_medium"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <FrameLayout
            android:id="@+id/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:background="#59FFFFFF"
            android:visibility="gone">

            <View
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#FFFFFFFF" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="180dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="#F2FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.02" />
</FrameLayout>
